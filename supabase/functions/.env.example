# Server-only secrets. NEVER prefix these with VITE_ or commit populated values.
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.

# Keep compatibility while the UI is developed. Enable otp only at cutover.
BOOKING_PUBLIC_MODE=compat

# At least 32 random bytes encoded as base64. Rotation invalidates pending codes.
BOOKING_OTP_SECRET=

# Server-only Resend API key. Never use a VITE_ prefix.
RESEND_API_KEY=
# Development sender is Lunara <onboarding@resend.dev>.
# Replace it in bookingEmail.js after verifying a production sending domain.
