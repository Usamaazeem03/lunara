# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key_here"

# Deployment staging only: deploy create-appointment before switching to "edge".
# This is NOT a verification flag. Direct writes must be closed in the database
# and the direct transport removed before enforced public OTP can go live.
VITE_APPOINTMENT_TRANSPORT="direct"

# Public URL for OAuth and Email Redirects
# For development: http://localhost:5173
# For production: https://yourdomain.com
# For ngrok tunneling: https://xxxxx.ngrok.io
VITE_PUBLIC_URL="http://localhost:5173"
