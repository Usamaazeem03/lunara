# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key_here"

# Deployment staging only: deploy create-appointment before switching to "edge".
# This is NOT a verification flag. Direct writes must be closed in the database
# and the direct transport removed before enforced public OTP can go live.
VITE_APPOINTMENT_TRANSPORT="direct"

# Public URL for share links, QR codes, OAuth and email redirects
VITE_PUBLIC_URL="https://www.lunara-booking.com"
